# Enrutamiento: toda petición que no corresponda a un archivo real
# se resuelve en index.php (front controller).
RewriteEngine On

# La API móvil de entregas usa Authorization: Bearer. Apache no siempre
# expone esa cabecera como HTTP_AUTHORIZATION; se copia explícitamente.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Rutas y archivos internos: nunca se sirven directamente (documentos fiscales,
# configuración, código, migraciones…). Solo public/ y build/ son públicos.
RewriteRule ^(storage|vendor|clases|includes|config|mysql|scripts|pruebas|templates|views|cambios|helm|design|src|node_modules|desktop|android|android-entregas)(/|$) - [F,L]
RewriteRule ^\.(?!well-known) - [F,L]
# Los version.json de las apps no son archivos: los responde index.php.
RewriteCond %{REQUEST_URI} !^/app/android/version\.json$
RewriteCond %{REQUEST_URI} !^/app/entregas/version\.json$
RewriteRule \.(env|md|sql|lock|log|sh|json|ya?ml|ini|example)$ - [F,L]
RewriteRule ^(Dockerfile|Router\.php|gulpfile\.js|deploy\.sh)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
