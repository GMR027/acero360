# ===========================================================================
#  .dockerignore — lo que NO viaja al contexto de build ni a la imagen
# ===========================================================================

# Dependencias y tooling local (vendor se genera en la etapa composer)
node_modules/
vendor/

# Entorno local y secretos — en K8s llegan por Secret/ConfigMap
.env
.env.example

# Control de versiones y docs
.git/
.gitignore
*.md

# Diseño y pruebas (no son necesarios en runtime)
design/
pruebas/
cambios/

# Infraestructura (el chart no va dentro de la imagen)
helm/
scripts/*
!scripts/migrar.php
!scripts/foto_inventario.php
!scripts/publicar_escritorio.php
# Respaldos: los scripts viajan dentro de la imagen porque el respaldo y la
# restauración se ejecutan en el clúster (manual y desde el CronJob).
!scripts/respaldar.sh
!scripts/restaurar.sh

# Copias locales: nunca dentro de la imagen
respaldos/

# Dump de datos: se importa vía ConfigMap, no desde la imagen
mysql/dump-inicial.sql

# Estado del script de despliegue
.deploy-tag

# SO/cache del editor
.DS_Store
Thumbs.db

# La aplicación de escritorio no viaja en la imagen del servidor
desktop/
public/image/recortes/
