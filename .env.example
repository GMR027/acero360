# ===========================================================================
#  .env.example — plantilla de configuración del entorno
#  Copia este archivo como .env y completá tus valores.
#  Nunca subas el archivo .env real a un repositorio.
# ===========================================================================

# --- Base de datos ---------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cotizaciones

# --- Registro de usuarios --------------------------------------------------
# 1 = el formulario de registro está abierto para cualquiera
# 0 = sólo los administradores existentes pueden dar de alta usuarios
REGISTRO_ABIERTO=0

# --- Exportación a PDF -----------------------------------------------------
# Ruta absoluta opcional de las fuentes; si se omite usan las de dompdf.
# PDF_FUENTES=/usr/share/fonts/truetype/dejavu
