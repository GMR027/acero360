{
  "name": "cotizaciones-escritorio",
  "productName": "Cotizaciones",
  "version": "1.0.0",
  "description": "Aplicación de escritorio de Cotizaciones: ventana segura hacia la plataforma web (los datos viven en el servidor).",
  "main": "src/main.js",
  "author": {
    "name": "Usuario Demo",
    "email": "admin@ejemplo.com"
  },
  "homepage": "https://cotizaciones.iguzman.com.mx",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:integracion": "node test/integracion.mjs",
    "empaquetar": "electron-builder --linux deb --x64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "mx.com.iguzman.cotizaciones",
    "productName": "Cotizaciones",
    "artifactName": "cotizaciones-escritorio_${version}_${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icons",
      "synopsis": "Cotizaciones, ventas, inventario y contabilidad",
      "description": "Ventana de escritorio para la plataforma Cotizaciones. Se conecta por HTTPS al servidor: no guarda una base de datos propia.",
      "maintainer": "Usuario Demo <admin@ejemplo.com>",
      "executableName": "cotizaciones-escritorio",
      "desktop": {
        "entry": {
          "Name": "Cotizaciones",
          "Comment": "Cotizaciones, ventas, inventario y contabilidad",
          "Categories": "Office;Finance;",
          "StartupWMClass": "cotizaciones-escritorio",
          "Keywords": "cotizaciones;ventas;inventario;contabilidad;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "cotizaciones-escritorio",
      "priority": "optional",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libcups2t64 | libcups2"
      ]
    }
  },
  "desktopName": "cotizaciones-escritorio.desktop"
}
