{
    "name": "edgar/cotizaciones",
    "description": "App web de cotizacion de productos para dos negocios",
    "type": "project",
    "authors": [
        {
            "name": "Edgar",
            "email": "admin@ejemplo.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1",
        "intervention/image": "^3.11",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./clases",
            "Model\\": "./models",
            "Classes\\": "./clases/herramientas"
        }
